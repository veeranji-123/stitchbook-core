# Server. 3001 keeps this service off the monolith port.
PORT=3001

# JWT Authentication
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET
JWT_EXPIRY=30d

# CORS
CORS_ORIGIN=*

# PostgreSQL
DB_HOST=localhost
DB_USER=stitchbook
DB_PASSWORD=REPLACE_WITH_ACTUAL_PASSWORD
DB_NAME=stitchbook_core
DB_PORT=5432
